# Modbus device to proxy (host:port)
MODBUS_DEVICE=10.0.0.30:502

# Name of the device in the register log (defaults to MODBUS_DEVICE)
MODBUS_NAME=sigenergy

# Port clients connect to (host and container)
PROXY_PORT=10502

# Register map describing requests in the log (shipped in the image)
REGISTER_MAP=/etc/modbus-proxy/registers/sigenergy.json

# Seconds between status summaries (clients, reads, writes), 0 disables
STATUS_INTERVAL=120
# Log level: error, warn, info, debug. Register reads are logged at debug,
# writes at info, failures at warn. Show reads too with
# RUST_LOG=info,modbus_proxy_rs::registers=debug
RUST_LOG=info

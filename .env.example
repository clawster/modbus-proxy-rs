# Modbus device to proxy (host:port)
MODBUS_DEVICE=10.0.0.30:502
# Port clients connect to (host and container)
PROXY_PORT=10502
# Register map describing requests in the log (shipped in the image)
REGISTER_MAP=/etc/modbus-proxy/registers/sigenergy.json
# Log level: error, warn, info, debug. Hide register lines with
# RUST_LOG=info,modbus_proxy_rs::registers=warn
RUST_LOG=info
